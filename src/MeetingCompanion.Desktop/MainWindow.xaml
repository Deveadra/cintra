<Window x:Class="MeetingCompanion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeting Companion" Width="640" Height="680" MinWidth="520" MinHeight="480">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Meeting Companion" FontSize="24" Margin="0,0,0,12" />
            <TextBlock Text="Stopped — audio is not connected." />
            <TextBlock Text="Manual snapshot · preview stays in memory · no upload" Margin="0,12,0,8" />
            <ComboBox x:Name="SourceMode" SelectedIndex="0" Margin="0,0,0,8" AutomationProperties.Name="Snapshot source">
                <ComboBoxItem Content="Last active external window" />
                <ComboBoxItem Content="Selected window" />
                <ComboBoxItem Content="Region on selected monitor" />
                <ComboBoxItem Content="Selected monitor" />
            </ComboBox>
            <ComboBox x:Name="WindowPicker" Margin="0,0,0,8" AutomationProperties.Name="Window to capture" />
            <ComboBox x:Name="MonitorPicker" Margin="0,0,0,8" AutomationProperties.Name="Monitor to capture" />
            <WrapPanel>
                <Button x:Name="CaptureButton" Content="Snapshot" Click="Snapshot_Click" Padding="16,6" />
                <Button Content="Refresh sources" Click="Refresh_Click" Margin="8,0" Padding="12,6" />
                <Button x:Name="CancelButton" Content="Cancel capture" Click="Cancel_Click" IsEnabled="False" Padding="12,6" />
                <Button Content="Clear preview" Click="Clear_Click" Margin="8,0,0,0" Padding="12,6" />
            </WrapPanel>
            <WrapPanel Margin="0,12,0,0">
                <TextBlock Text="Global hotkey: Ctrl+Shift+" VerticalAlignment="Center" />
                <TextBox x:Name="HotkeyKey" Text="S" Width="40" MaxLength="1" AutomationProperties.Name="Hotkey letter" />
                <Button x:Name="HotkeyApplyButton" Content="Apply hotkey" Click="Hotkey_Click" Margin="8,0" Padding="8,4" />
            </WrapPanel>
            <TextBlock x:Name="HotkeyStatus" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock x:Name="CaptureStatus" Text="Ready — choose a source and press Snapshot." TextWrapping="Wrap" Margin="0,12,0,12" />
        </StackPanel>
        <Border BorderBrush="Gray" BorderThickness="1"><Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="Snapshot preview" /></Border>
    </DockPanel>
</Window>
